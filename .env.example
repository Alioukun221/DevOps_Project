# Copier ce fichier en .env avant de lancer le stack :
#   cp .env.example .env

# Ollama et Open WebUI
OLLAMA_PORT=11434
WEBUI_PORT=3000


EXPORTER_PORT=9105
# Modeles sondes par l'exporter, separes par des virgules.
EXPORTER_MODELS=gemma3:1b
# Workers demarres avec le stack. Se change a chaud pour monter en charge :
#   curl -X POST "http://localhost:9105/concurrency?value=4"
EXPORTER_CONCURRENCY=1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
